#!/usr/bin/env python3
"""Make the wallpaper in each screen shape.

GNOME zooms one picture to fill the screen, so a screen that is not 16:9
loses the picture's edges, and the wordmark with them. This cuts the
background to each shape first and then puts the wordmark in the corner, so
it sits in the same place on every screen.

    make-wallpapers <branding dir> <output dir>

fit-wallpaper (in files/usr/libexec/stagerig-os) chooses between the results
by name; keep SHAPES here and there the same.
"""
import os
import sys

from PIL import Image, ImageDraw, ImageFilter

# name suffix, width : height
SHAPES = [
    ("", 16, 9),
    ("-16x10", 16, 10),
    ("-3x2", 3, 2),
    ("-4x3", 4, 3),
    ("-21x9", 43, 18),
    ("-32x9", 32, 9),
]
RIGHT_GAP = 149 / 3840      # of the 16:9 picture's width, kept in pixels
BOTTOM_GAP = 223 / 2160     # of each picture's own height


def main(branding, out):
    background = Image.open(os.path.join(branding, "wallpaper-background.png")).convert("RGB")
    wordmark = Image.open(os.path.join(branding, "wallpaper-wordmark.png")).convert("RGBA")
    width, height = background.size
    os.makedirs(out, exist_ok=True)
    for suffix, w, h in SHAPES:
        if w * height <= h * width:         # narrower: cut the sides
            cw, ch = round(height * w / h / 2) * 2, height
        else:                               # wider: cut top and bottom
            cw, ch = width, round(width * h / w / 2) * 2
        left, top = (width - cw) // 2, (height - ch) // 2
        picture = background.crop((left, top, left + cw, top + ch))
        x = cw - round(RIGHT_GAP * width) - wordmark.width
        y = ch - round(BOTTOM_GAP * ch) - wordmark.height
        if top:
            # Cut this way the wordmark sits higher on the floor, on the
            # bright reflections, where the amber letters are lost: dim the
            # floor under it.
            pad = 110
            shade = Image.new("L", picture.size, 0)
            ImageDraw.Draw(shade).rounded_rectangle(
                (x - pad, y - pad // 2, x + wordmark.width + pad, y + wordmark.height + pad // 2),
                radius=pad, fill=185)
            shade = shade.filter(ImageFilter.GaussianBlur(55))
            picture.paste((0, 2, 8), (0, 0), shade)
        picture.paste(wordmark, (x, y), wordmark)
        path = os.path.join(out, "signal-stage%s.png" % suffix)
        picture.save(path, optimize=True)
        print("%s  %dx%d" % (path, cw, ch))


if __name__ == "__main__":
    if len(sys.argv) != 3:
        sys.exit(__doc__)
    main(sys.argv[1], sys.argv[2])
